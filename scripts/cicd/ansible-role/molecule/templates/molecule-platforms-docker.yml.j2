---
<% for platform in platforms | dict2items %>
<% if platform.key != 'defaults' %>
<% set defaults = platforms.defaults %>
<% set __platform = defaults | combine(platform.value, recursive=true) %>
<% if platform.value.molecule.docker is defined %>
- name: <= platform.key =>
  ci: <= __platform.ci | lower =>
<% if __platform.molecule.docker.image is defined %>
  image: <= __platform.molecule.docker.image =>
<% endif %>
<% if __platform.molecule.docker.memory is defined %>
  memory: <= __platform.molecule.docker.memory | lower =>
<% endif %>
<% if __platform.molecule.docker.kernel_memory is defined %>
  kernel_memory: <= __platform.molecule.docker.kernel_memory | lower =>
<% endif %>
<% if __platform.molecule.docker.privileged is defined %>
  privileged: <= __platform.molecule.docker.privileged | lower =>
<% endif %>
<% if __platform.molecule.docker.capabilities is defined %>
  capabilities: <= __platform.molecule.docker.capabilities | lower =>
<% endif %>
<% if __platform.molecule.docker.pre_build_image is defined %>
  pre_build_image: <= __platform.molecule.docker.pre_build_image | lower =>
<% endif %>
<% if __platform.molecule.docker.cgroupns_mode is defined %>
  cgroupns_mode: <= __platform.molecule.docker.cgroupns_mode | lower =>
<% endif %>
<% if __platform.molecule.docker.environment is defined %>
  environment:
<% for key, value in __platform.molecule.docker.environment.items() %>
<% if value is search('{{') %>
    <= key =>: "<= value =>"
<% else %>
    <= key =>: <= value =>
<% endif %>
<% endfor %>
<% endif %>
<% if __platform.molecule.docker.volumes is defined %>
  volumes:
<% for volume in __platform.molecule.docker.volumes %>
    - <= volume =>
<% endfor %>
<% endif %>
<% if __platform.molecule.docker.networks is defined %>
  networks:
<% for network in __platform.molecule.docker.networks %>
    - <= network =>
<% endfor %>
<% endif %>
<% if __platform.molecule.docker.ports is defined %>
  ports:
<% for port in __platform.molecule.docker.ports %>
    - <= port =>
<% endfor %>
<% endif %>
<% if __platform.rhsm is defined %>
  rhsm: <= __platform.rhsm | lower =>
<% endif %>
<% endif %>
<% endif %>
<% endfor %>
