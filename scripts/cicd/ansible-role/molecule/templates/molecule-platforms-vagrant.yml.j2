---

<% for platform in platforms | dict2items %>
<% if platform.key != 'defaults' %>
<% set defaults = platforms.defaults %>
<% set __platform = defaults | combine(platform.value, recursive=true) %>
<% if platform.value.molecule.vagrant is defined %>
- name: <= platform.key =>
  ci: <= __platform.ci | lower =>
<% if __platform.molecule.vagrant.box is defined %>
  box: <= __platform.molecule.vagrant.box =>
<% endif %>
<% if __platform.molecule.vagrant.memory is defined %>
  memory: <= __platform.molecule.vagrant.memory =>
<% endif %>
<% if __platform.molecule.vagrant.cpus is defined %>
  cpus: <= __platform.molecule.vagrant.cpus =>
<% endif %>
<% if __platform.molecule.vagrant.groups is defined %>
  groups: <= __platform.molecule.vagrant.groups =>
<% endif %>
<% if __platform.molecule.vagrant.interfaces is defined %>
  interfaces: <= __platform.molecule.vagrant.interfaces =>
<% endif %>
<% if __platform.molecule.vagrant.instance_raw_config_args is defined %>
  instance_raw_config_args: <= __platform.molecule.vagrant.instance_raw_config_args =>
<% endif %>
<% if __platform.molecule.vagrant.provider is defined %>
  provider: <= __platform.molecule.vagrant.provider =>
<% endif %>
<% if __platform.molecule.vagrant.provider_options is defined %>
  provider_options: <= __platform.molecule.vagrant.provider_options =>
<% endif %>
<% if __platform.molecule.vagrant.provider_raw_config_args is defined %>
  provider_raw_config_args: <= __platform.molecule.vagrant.provider_raw_config_args =>
<% endif %>
<% endif %>
<% endif %>
<% endfor %>
