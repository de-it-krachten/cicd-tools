---
<% for platform in platforms | dict2items %>
  <% if platform.key != 'defaults' %>
    <% set defaults = platforms.defaults %>
    <% set __platform = defaults | combine(platform.value, recursive=true) %>
    <% if platform.value.molecule.podman is defined %>
- name: <= platform.key =>
  ci: <= __platform.ci | lower =>
      <% if __platform.molecule.podman.image is defined %>
  image: <= __platform.molecule.docker.image =>
      <% endif %>
      <% if __platform.molecule.podman.memory is defined %>
  memory: <= __platform.molecule.podman.memory | lower =>
      <% endif %>
      <% if __platform.molecule.podman.kernel_memory is defined %>
  kernel_memory: <= __platform.molecule.podman.kernel_memory | lower =>
      <% endif %>
      <% if __platform.molecule.podman.privileged is defined %>
  privileged: <= __platform.molecule.podman.privileged | lower =>
      <% endif %>
      <% if __platform.molecule.podman.capabilities is defined %>
  capabilities: <= __platform.molecule.podman.capabilities =>
      <% endif %>
      <% if __platform.molecule.podman.pre_build_image is defined %>
  pre_build_image: <= __platform.molecule.podman.pre_build_image | lower =>
      <% endif %>
      <% if __platform.molecule.podman.environment is defined %>
  environment:
        <% for key, value in __platform.molecule.podman.environment.items() %>
          <% if value is search('{{') %>
    <= key =>: "<= value =>"
          <% else %>
    <= key =>: <= value =>
          <% endif %>
        <% endfor %>
      <% endif %>
      <% if __platform.molecule.podman.volumes is defined %>
  volumes:
        <% for volume in __platform.molecule.podman.volumes %>
    - <= volume =>
        <% endfor %>
      <% endif %>
      <% if __platform.molecule.podman.networks is defined %>
  networks:
        <% for network in __platform.molecule.podman.networks %>
    - <= network =>
        <% endfor %>
      <% endif %>
      <% if __platform.molecule.podman.ports is defined %>
  ports:
        <% for port in __platform.molecule.podman.ports %>
    - <= port =>
        <% endfor %>
      <% endif %>
      <% if __platform.rhsm is defined %>
  rhsm: <= __platform.rhsm | lower =>
      <% endif %>
    <% endif %>
  <% endif %>
<% endfor %>
